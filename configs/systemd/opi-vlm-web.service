[Unit]
# Legacy CPU stack retired; never autostart from an Intern deployment.
ConditionPathExists=/opt/opi-vlm/enable-legacy-cpu-model
Description=Orange Pi visual chat web UI
After=network.target

[Service]
User=opi-vlm
Group=opi-vlm
WorkingDirectory=/opt/opi-vlm
ExecStart=/usr/bin/python3 /opt/opi-vlm/app/server.py --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
MemoryMax=256M

[Install]
WantedBy=multi-user.target
